rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: only the user can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Drafts sub-collection
      match /drafts/{draftId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Skills collection: anyone can read, only author can write
    match /skills/{skillId} {
      allow read: if true;
      allow write: if request.auth != null && (
        // Allow creating if authorId matches sender
        (request.resource.data.authorId == request.auth.uid) ||
        // Allow updating if existing authorId matches sender
        (resource.data.authorId == request.auth.uid)
      );
    }
    
    // Fallback: deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
