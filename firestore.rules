rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ----------------------------------------------------------------------
    // SKILLS COLLECTION
    // ----------------------------------------------------------------------
    match /skills/{skillId} {
      // Anyone can read skills (or change to 'if request.auth != null' if login is strictly required to view skills)
      allow read: if true;
      
      // Users can only create skills where they are the designated author
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      
      // Users can only update/delete their own skills
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }
    
    // ----------------------------------------------------------------------
    // USERS COLLECTION (including drafts and installed_skills)
    // ----------------------------------------------------------------------
    match /users/{userId} {
      // Only the authenticated user can read/write their own root document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Match all subcollections like 'drafts' and 'installed_skills'
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
  }
}
