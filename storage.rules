rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Skills directory: any nested path under /skills/ is accessible
    match /skills/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fallback: deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
