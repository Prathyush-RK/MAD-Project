<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp">

    <ImageView
        android:id="@+id/ivActiveSkillIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/shape_icon_bg"
        android:backgroundTint="@color/surface_variant"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@android:drawable/ic_menu_edit" />

    <TextView
        android:id="@+id/tvActiveSkillTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        app:layout_constraintEnd_toStartOf="@+id/ivStatusDot"
        app:layout_constraintStart_toEndOf="@+id/ivActiveSkillIcon"
        app:layout_constraintTop_toTopOf="@+id/ivActiveSkillIcon"
        tools:text="Blog Ghost Writer" />

    <TextView
        android:id="@+id/tvActiveSkillUsage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@+id/tvActiveSkillTitle"
        app:layout_constraintStart_toStartOf="@+id/tvActiveSkillTitle"
        app:layout_constraintTop_toBottomOf="@+id/tvActiveSkillTitle"
        tools:text="Used 18 times this week" />

    <!-- Status dot -->
    <View
        android:id="@+id/ivStatusDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/shape_status_dot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
