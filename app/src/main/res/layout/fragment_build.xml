<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="serif"
            android:textStyle="italic"
            android:text="Build a Skill"
            android:textColor="@color/text_primary"
            android:textSize="40sp" />

        <!-- Hero Card: Create from Scratch -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCreateFromScratch"
            style="@style/Widget.SkillForge.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Create from scratch"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Define behaviour, context &amp; examples"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNewSkill"
                        style="@style/Widget.SkillForge.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manual" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChatBuilder"
                        style="@style/Widget.SkillForge.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Chat with AI" />
                </LinearLayout>
                
                <TextView
                    android:id="@+id/btnImportSkill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Import .md"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    android:textColor="@color/brand_primary"
                    android:background="?attr/selectableItemBackground" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Templates Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="48dp"
            android:letterSpacing="0.1"
            android:text="START FROM A TEMPLATE"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textAllCaps="true" />

        <!-- Templates List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTemplates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="8dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_build_template"
            tools:itemCount="3" />

        <!-- My Drafts Section Header -->
        <TextView
            android:id="@+id/tvMyDraftsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="48dp"
            android:letterSpacing="0.1"
            android:text="MY DRAFTS"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textAllCaps="true"
            android:visibility="gone" />

        <!-- Drafts List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDrafts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="8dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_draft"
            tools:itemCount="1" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

