<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="@color/surface_variant" />

            <ImageView
                android:id="@+id/ivSkillIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/shape_icon_bg"
                android:backgroundTint="@color/surface_variant"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvSkillTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                tools:text="React Component Tester" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCategory"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/brand_primary"
                app:chipBackgroundColor="@color/surface_variant"
                app:chipStrokeWidth="0dp"
                tools:text="Code" />

            <TextView
                android:id="@+id/tvSkillStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="★★★★★  4.8 · 1.4k installs" />

            <TextView
                android:id="@+id/tvSkillDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="This skill helps you test React components by generating test cases automatically." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="24dp"
                android:background="@color/surface_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.1"
                android:text="SKILL.MD CONTENT"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:shimmer_duration="1000">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/surface_variant" />
                    <View
                        android:layout_width="200dp"
                        android:layout_height="20dp"
                        android:layout_marginBottom="24dp"
                        android:background="@color/surface_variant" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:background="@color/surface_variant" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <TextView
                android:id="@+id/tvMarkdownContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:visibility="gone"
                tools:text="# Markdown Content\n\n- Point 1\n- Point 2" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg_dark"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInstall"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Install Skill"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/brand_primary" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
